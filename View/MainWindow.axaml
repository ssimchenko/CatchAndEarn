                    <TextBlock x:Name="WinCoinsText"
                               Text="Монеты: 0"
                               Foreground="#8ecae6"
                               FontSize="24"
                               HorizontalAlignment="Center"/>

                    <Button Content="В главное меню"
                            Width="200"
                            Height="45"
                            Click="BackToMenu_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Viewbox>

